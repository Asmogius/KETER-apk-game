; KETER, the game (v0.7: finishing the fight).
; Engine configuration file. Godot 4.7.

config_version=5

[application]

config/quit_on_go_back=false

config/name="KETER"
config/version="0.41"
config/description="KETER, the video game. v0.16: the fight's effects, drawn frame by frame: a muzzle flash as a shot leaves, an impact where damage lands, an explosion on every tile a blast catches, a heal rising from whoever is mended, a shield as an attack glances off armour; and a strip in the side panel of what a Unit can still do this turn, Move, Attack and Hold fire, each with its icon; on 0.15's World Map and menus and 0.14's fight, drawn. Build Strike Teams and send them out from the dock onto the World Map, where each fight is a Battle of six waves. Their Troops are your own designs, made in the Workshop. What they bring home is spent at the dock: the Exchange, Reclaiming, the Bounty Board and upgrades. Battle and Quick battle are practice fights."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.03, 0.04, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

export/convert_text_resources_to_binary=false

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.04, 1)
