## The proof that rules.gd is the Companion's rules.js: thousands of cases
## generated by running rules.js (make_rule_cases.js), each replayed here and
## compared answer by answer, event by event, and Unit by Unit.
##   godot --headless --path . --script res://tests/rules_diff.gd
extends SceneTree

const CASES := "res://tests/fixtures/rule_cases.json"
var by_fn := {}      # fn -> [passed, failed]
var shown := {}      # fn -> failures printed


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	var raw := FileAccess.get_file_as_string(CASES)
	var data = JSON.parse_string(raw)
	if not (data is Dictionary):
		print("FAIL no cases at " + CASES)
		print("\nRULES MATCH 0  DIFFER 1")
		quit(1)
		return
	data = Rules.ints(data)
	var t0 := Time.get_ticks_msec()
	for c in data["cases"]:
		_case(c)
	var ok := 0
	var bad := 0
	var names := by_fn.keys()
	names.sort()
	for fn in names:
		ok += by_fn[fn][0]
		bad += by_fn[fn][1]
		print(("PASS " if by_fn[fn][1] == 0 else "FAIL ") + "%s: %d of %d match" % [fn, by_fn[fn][0], by_fn[fn][0] + by_fn[fn][1]])
	print("(%d ms, from %s with %d cards)" % [Time.get_ticks_msec() - t0, data.get("made", "?"), data.get("cards", 0)])
	print("\nRULES MATCH %d  DIFFER %d" % [ok, bad])
	quit(1 if bad > 0 else 0)


func _tally(fn: String, good: bool, got, want) -> void:
	if not by_fn.has(fn):
		by_fn[fn] = [0, 0]
	by_fn[fn][0 if good else 1] += 1
	if not good and shown.get(fn, 0) < 3:
		shown[fn] = shown.get(fn, 0) + 1
		print("DIFF %s\n   rules.gd: %s\n   rules.js: %s" % [fn, JSON.stringify(_plain(got)).left(700), JSON.stringify(_plain(want)).left(700)])


# ---------------------------------------------------------------- comparing
## Missing and null are the same (JSON drops JavaScript's undefined); numbers
## match within a hair; Vector2 compares as {x, y}.
func same(a, b) -> bool:
	a = _plain(a)
	b = _plain(b)
	if a == null or b == null:
		return a == null and b == null
	if (a is int or a is float) and (b is int or b is float):
		return absf(float(a) - float(b)) < 1e-6
	if a is bool or b is bool:
		return a is bool and b is bool and a == b
	if (a is String or a is StringName) and (b is String or b is StringName):
		return str(a) == str(b)
	if a is Array and b is Array:
		if a.size() != b.size():
			return false
		for i in a.size():
			if not same(a[i], b[i]):
				return false
		return true
	if a is Dictionary and b is Dictionary:
		var keys := {}
		for k in a: keys[k] = true
		for k in b: keys[k] = true
		for k in keys:
			if not same(a.get(k), b.get(k)):
				return false
		return true
	return false


func _plain(v):
	if v is Vector2:
		return {"x": v.x, "y": v.y}
	if v is PackedFloat64Array and v.size() == 2:
		return {"x": v[0], "y": v[1]}       # a point of the sight geometry
	if v is Array:
		return v.map(func(x): return _plain(x))
	if v is Dictionary:
		var d := {}
		for k in v:
			d[k] = _plain(v[k])
		return d
	return v


func _check(fn: String, got, want) -> void:
	_tally(fn, same(got, want), got, want)


# ---------------------------------------------------------------- the cases
func _dist_pos(a, b):
	return Rules.hex_distance(a["pos"], b["pos"])


func _case(c: Dictionary) -> void:
	var fn: String = c["fn"]
	var A: Array = c["args"]
	var want = c.get("result")
	var after = c.get("after")
	match fn:
		"num":
			_check(fn, Rules.num(A[0], A[1]), want)
		"hexDistance":
			_check(fn, Rules.hex_distance(A[0], A[1]), want)
		"hexLine":
			_check(fn, Rules.hex_line(A[0], A[1]), want)
		"hexNeighbours":
			_check(fn, Rules.hex_neighbours(A[0], A[1]), want)
		"hexParse":
			_check(fn, Rules.hex_parse(A[0]), want)
		"reachable":
			var f: Dictionary = A[2]
			var walls: Dictionary = f["walls"]
			var got := Rules.reachable(A[0], A[1], {
				"passable": func(n): return f["tiles"].has(Rules.hex_key(n["q"], n["r"])),
				"blocked": func(n): return f["blocked"].has(Rules.hex_key(n["q"], n["r"])),
				"wall": func(a, b): return walls.has(Rules.hex_key(a["q"], a["r"]) + "|" + Rules.hex_key(b["q"], b["r"])) or walls.has(Rules.hex_key(b["q"], b["r"]) + "|" + Rules.hex_key(a["q"], a["r"])),
			})
			_check(fn, got, want)
		"lineOfSight":
			_check(fn, Rules.line_of_sight(A[0], A[1], A[2]), want)
		"wallSegments":
			_check(fn, Rules.wall_segments(A[0]), want)
		"unitFromCard":
			var u := Rules.unit_from_card(A[0], A[1])
			u["id"] = A[2]
			_check(fn, u, want)
		"chipValue":
			_check(fn, Rules.chip_value(A[0]), want)
		"actionEffect":
			_check(fn, Rules.action_effect(A[0]), want)
		"makeUnit":
			_check(fn, Rules.make_unit(A[0]), want)
		"hit", "heal", "gain":
			var u: Dictionary = A[0]
			var ev: Array = Rules.hit(u, A[1]) if fn == "hit" else (Rules.heal(u, A[1]) if fn == "heal" else Rules.gain(u, A[1]))
			_check(fn, [ev, u], [want, after])
		"aetherCanPay":
			_check(fn, Rules.aether_can_pay(A[0], A[1]), want)
		"aetherPay":
			var pool: Dictionary = A[0]
			var ok := Rules.aether_pay(pool, A[1])
			# (Until Companion 13.3, rules.js left Not-a-Number in a pool that
			# had none of a card's District; this once allowed for it.)
			_check(fn, [ok, pool], [want, after])
		"aetherTotal":
			_check(fn, Rules.aether_total(A[0]), want)
		"aetherAdd":
			_check(fn, Rules.aether_add(A[0], A[1]), want)
		"aetherFromHero":
			_check(fn, Rules.aether_from_hero(A[0]), want)
		"aetherIncome":
			_check(fn, Rules.aether_income(A[0], A[1]), want)
		"dice":
			var d := Rules.make_dice(A[0])
			var rolls := []
			for k in A[1]:
				rolls.append(d.roll(k))
			_check(fn, rolls, want)
		"resolveAttack":
			var ctx: Dictionary = A[3]
			if A[4] != null:
				ctx["dice"] = Rules.make_dice(A[4])
			_check(fn, Rules.resolve_attack(A[0], A[1], A[2], ctx), want)
		"rollsFor":
			_check(fn, Rules.rolls_for(A[0], A[1]), want)
		"attack":
			var ctx2: Dictionary = A[3]
			if A[4] != null:
				ctx2["dice"] = Rules.make_dice(A[4])
			var ev2 := Rules.attack(A[0], A[1], A[2], ctx2)
			_check(fn, [ev2, [A[0], A[2]]], [want, after])
		"useAction":
			var ev3 := Rules.use_action(A[0], A[1], A[2])
			var tgt = A[2]
			if tgt == null:
				_check(fn, [ev3, A[0]], [want, after[0]])
			else:
				_check(fn, [ev3, [A[0], tgt]], [want, after])
		"canAfford":
			_check(fn, Rules.can_afford(A[0], A[1]), want)
		"chooseTarget":
			var me: Dictionary = A[0]
			var t = Rules.choose_target(me, A[1], {"distance": func(u): return Rules.hex_distance(me["pos"], u["pos"])})
			_check(fn, t["id"] if t != null else null, want)
		"movePlan":
			_check(fn, Rules.move_plan(A[0], {"nearestEnemyDistance": A[1]}), want)
		"bestAction":
			_check(fn, Rules.best_action(A[0], A[1], {"distance": _dist_pos}), want)
		"supportPlan":
			var p = Rules.support_plan(A[0], A[1])
			_check(fn, {"action": p["action"], "target": p["target"]["id"], "why": p["why"]} if p != null else null, want)
		"escortTarget":
			var e = Rules.escort_target(A[0], A[1])
			_check(fn, e["id"] if e != null else null, want)
		"outcome":
			_check(fn, Rules.outcome(A[0]), want)
		"nextComboAction":
			_check(fn, Rules.next_combo_action(A[0]), want)
		"endTurn":
			var ev4 := Rules.end_turn(A[0])
			_check(fn, [ev4, A[0]], [want, after])
		"runCombat":
			var o: Dictionary = A[1]
			var ctx3 := _fight_ctx(o)
			ctx3["maxRounds"] = o["maxRounds"]
			var res := Rules.run_combat(A[0], ctx3)
			_check(fn, [{"winner": res["winner"], "rounds": res["rounds"], "log": res["log"], "survivors": res["survivors"]}, res["units"]], [want, after])
		"enemyTurn":
			var units: Array = A[0]
			var me2 = units.filter(func(u): return u["id"] == A[1])[0]
			var ev5 := Rules.enemy_turn(me2, {"units": units}, _fight_ctx(A[2]))
			_check(fn, [ev5, units], [want, after])
		"statusScript":
			var u2: Dictionary = A[0]
			var outs := []
			var half_now := ["ally"]
			Rules.hooks = {"half": func(): return half_now[0]}
			for st in A[1]:
				match st[0]:
					"tickLate": outs.append(Rules.turn_end_tick([u2]))
					"half":
						half_now[0] = st[1]
						outs.append(st[1])
					"add": outs.append(Rules.add_status(u2, st[1], st[2], st[3], st[4]))
					"drop": outs.append(Rules.drop_status(u2, st[1]))
					"tick": outs.append(Rules.recharge_tick([u2]))
					"eff": outs.append(Rules.effective(u2))
					"n": outs.append(Rules.status_n(u2, st[1]))
					"turns": outs.append(Rules.status_turns(u2, st[1]))
					"has": outs.append(Rules.has_status(u2, st[1]))
			Rules.hooks = {}
			_check(fn, [outs, u2], [want, after])
		_:
			_tally("unknown:" + fn, false, null, null)


func _fight_ctx(o: Dictionary) -> Dictionary:
	var covers: Dictionary = o.get("covers", {})
	var ctx := {"dice": Rules.make_dice(o["seed"]), "coverFor": func(t, _a): return covers.get(t["id"], 0) if Rules.truthy(covers.get(t["id"])) else 0}
	if o.get("maps"):
		ctx["distance"] = _dist_pos
	return ctx
